@article{saneba_savoirs_2015,
	title = {Savoirs féminins et féeriques au {Moyen} Âge. {Le} cas de {Mélusine} dans les romans de {Jean} d'{Arras} et de {Coudrette}},
	volume = {10},
	issn = {1715-9261},
	url = {https://uottawa.scholarsportal.info/ottawa/index.php/revue-analyses/article/view/1240},
	doi = {10.18192/analyses.v10i1.1240},
	abstract = {Nous proposons d'analyser les « savoirs féeriques » d’une fée célèbre de la littérature médiévale, Mélusine, la femme-serpente, nommée pour la première fois par Jean d’Arras dans son roman Mélusine ou la noble Histoire de Lusignan, dès 1392, puis dans la version en vers de Coudrette aux alentours de 1401. Notre étude se fondera sur deux axes : l’imaginaire lié à la légende de la fée et les enjeux socio-historiques des deux romans français mélusiniens. Nous questionnerons la nature de ces savoirs qui confèrent à la fée ses pouvoirs magiques et nous nous demanderons s’ils font d’elle une fée ou une sorcière. Nous analyserons le caractère duel de la fée, mi-femme, mi-serpente, car cette femme « merveilleuse » n’en est pas moins animale, bien qu’elle soit distinctement humanisée dans les deux romans français. Du côté des enjeux socio-historiques des romans mélusiniens, nous analyserons la fonction historique des savoirs de la fée. Nous spécifierons les savoirs terrestres que possède Mélusine au-delà des savoirs surnaturels et qui font d’elle une fée civilisatrice. Cet article a pour objectif de revenir sur cette figure féerique emblématique du Moyen Âge, rassurante et inquiétante à la fois, qui symbolise le mystère féminin. Il nous semble légitime que cette fée, maîtresse de savoirs surnaturels et terrestres, trouve sa place dans l’univers des savoirs au féminin en littérature et qu’elle nous rappelle un Moyen Âge mythique qui a su inspirer un grand nombre d’auteurs au fil des siècles.},
	number = {1},
	urldate = {2019-12-19},
	journal = {@nalyses. Revue des littératures franco-canadiennes et québécoise},
	author = {Saneba, Magalie},
	year = {2015},
	pages = {117--139},
}

