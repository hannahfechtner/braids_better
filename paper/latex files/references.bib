	doi = {10.1007/978-1-4684-0110-3_8},
	abstract = {We have seen (4.2.7) that the (m, n) torus knot has group\$\$G\_\{m\{{\textbackslash}rm\{,\}\}n\} = {\textbackslash}langle a,b;a{\textasciicircum}m = b{\textasciicircum}n {\textbackslash}rangle\$\$It is obvious that Gm, n= Gn, m, which reflects the less obvious fact that the (m, n) torus knot is the same as the (n, m) torus knot. Gm, ndoes not reflect the orientation of the knot in R3, since the knot and its mirror image have homeomorphic complements and hence the same group. Since Listing 1847, at least, it has been presumed that there is no ambient isotopy in R3 between the two trefoil knots (Figure 219) and the same applies to the general (m, n) knot.},
	language = {en},
