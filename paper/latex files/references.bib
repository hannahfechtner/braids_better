	keywords = {Abortion, Spontaneous, Adaptation, Physiological, Animals, Bacterial Toxins, Breast Diseases, Coitus, Enterotoxins, Estrus, Female, Humans, Hyperemesis Gravidarum, Libido, Orgasm, Ovulation, Pain, Pregnancy, Pregnancy Trimester, First, Uterine Contraction, Uterus, Vomiting},
